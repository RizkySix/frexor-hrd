// Prisma schema for the VAK Working Style Test app.
//
// Note: Prisma does not allow env() for the `provider` field — it must be a
// literal string. We use `postgresql` for both local dev and production.
// For local development, point DATABASE_URL at a free Neon branch
// (https://neon.tech) or a local Postgres via Docker.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HRDUser {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  password               String
  name                   String
  createdAt              DateTime               @default(now())
  candidates             Candidate[]
  rsvpEvents             RSVPEvent[]
  surveyAnalysisEdits    SurveyAnalysisResult[] @relation("SurveyAnalysisEditor")
  surveyPeriods          SurveyPeriod[]
}

model Candidate {
  id            String    @id @default(cuid())
  name          String
  position      String
  token         String    @unique @default(cuid())
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  submittedAt   DateTime?

  scoreV        Int?
  scoreA        Int?
  scoreK        Int?
  dominantStyle String?

  answers       Answer[]
  createdBy     String
  hrd           HRDUser   @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
}

model Answer {
  id          String    @id @default(cuid())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String
  questionNo  Int
  answer      String

  @@unique([candidateId, questionNo])
}

model RSVPEvent {
  id              String         @id @default(cuid())
  title           String
  description     String?
  eventAt         DateTime
  token           String         @unique @default(cuid())
  dropdownOptions Json?
  createdAt       DateTime       @default(now())

  createdBy       String
  hrd             HRDUser        @relation(fields: [createdBy], references: [id])
  responses       RSVPResponse[]

  @@index([createdBy])
}

model RSVPResponse {
  id            String    @id @default(cuid())
  event         RSVPEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       String
  name          String
  dropdownValue String?
  status        String
  reason        String?
  submittedAt   DateTime  @default(now())

  @@index([eventId])
  @@index([eventId, name])
}

enum SurveyAnalysisSource {
  AI_WEBHOOK
  MANUAL_HRD
}

model SurveyPeriod {
  id          String             @id @default(cuid())
  label       String
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())

  createdBy   String
  hrd         HRDUser            @relation(fields: [createdBy], references: [id])
  submissions SurveySubmission[]

  @@index([startsAt, endsAt])
  @@index([isActive])
}

model SurveySubmission {
  id              String        @id @default(cuid())
  submittedAt     DateTime      @default(now())
  answers         Json
  textAnswers     Json
  isProcessed     Boolean       @default(false)

  // Periodic survey + anti-duplicate
  periodId        String?
  period          SurveyPeriod? @relation(fields: [periodId], references: [id])
  // Hash dari random client token (cookie HttpOnly). Anonim — bukan IP, bukan user id.
  // Unique per (periodId, clientTokenHash) → 1 submission per browser per periode.
  clientTokenHash String?

  @@index([isProcessed])
  @@index([submittedAt])
  @@index([periodId])
  @@unique([periodId, clientTokenHash])
}

model SurveyAnalysisResult {
  id               String               @id @default(cuid())
  periodLabel      String
  analysisPayload  Json
  // { company_strengths: string[], top_improvement_areas: string[],
  //   actionable_suggestions: string[], retention_sentiment: string|null,
  //   retention_summary: string|null }
  qualitativeData  Json?
  // Raw per-section narrative dari AI — bentuknya tidak distandarisasi,
  // ditampilkan apa adanya (read-only) di dashboard.
  sectionAnalyses  Json?
  summaryText      String?
  overallAvg       Decimal              @db.Decimal(3, 2)
  totalRespondents Int
  generatedBy      SurveyAnalysisSource @default(AI_WEBHOOK)
  generatedAt      DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  updatedByUserId  String?
  updatedBy        HRDUser?             @relation("SurveyAnalysisEditor", fields: [updatedByUserId], references: [id])

  @@index([generatedAt])
  @@index([periodLabel])
}

enum DriverGender {
  MALE
  FEMALE
}

enum DriverShirtSize {
  S
  M
  L
  XL
  XXL
  XXXL
  XXXXL
}

model DriverSizeSubmission {
  id               String           @id @default(cuid())
  name             String
  phone            String
  phoneNormalized  String           @unique
  gender           DriverGender
  size             DriverShirtSize
  submittedAt      DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([submittedAt])
  @@index([size])
}

enum BloodType {
  A
  B
  AB
  O
  UNKNOWN
}

enum Religion {
  ISLAM
  KRISTEN
  KATOLIK
  HINDU
  BUDDHA
  KONGHUCU
  LAINNYA
}

enum MaritalStatus {
  BELUM_KAWIN
  KAWIN
  CERAI_HIDUP
  CERAI_MATI
}

enum LastEducation {
  SD
  SMP
  SMA_SMK
  D3
  S1
  S2
  S3
  LAINNYA
}

model DriverPartner {
  id                     String         @id @default(cuid())
  fullName               String
  birthPlace             String
  birthDate              DateTime
  gender                 DriverGender
  bloodType              BloodType
  address                String         @db.Text
  religion               Religion
  maritalStatus          MaritalStatus
  nik                    String         @unique
  kkNumber               String
  npwp                   String?
  ptkpStatus             String
  noRekening             String?
  phone                  String
  email                  String
  currentAddress         String?        @db.Text
  lastEducation          LastEducation?
  emergencyName          String
  emergencyPhone         String
  roketAccountName       String
  workStartDate          DateTime
  ktpPhotoUrl            String
  kkPhotoUrl             String
  npwpPhotoUrl           String?
  submittedAt            DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([submittedAt])
}

// Interview form (FO-HR.SUN-008/FI). Public applicants fill a shareable link;
// HRD reviews/exports from the dashboard. Repeating sections (family members,
// education rows, languages, work history) are stored as JSON arrays since
// they are captured-and-displayed rather than queried individually — same
// approach the survey feature uses for its nested answer data.
model InterviewSubmission {
  id                 String        @id @default(cuid())

  // Header
  appliedPosition    String
  photoUrl           String?

  // A. Identitas
  fullName           String
  nickname           String?
  birthPlace         String
  birthDate          DateTime?
  gender             DriverGender
  heightCm           String?
  weightKg           String?
  bloodType          BloodType
  ktpAddress         String        @db.Text
  homePhone          String?
  currentAddress     String?       @db.Text
  bcaAccount         String?
  citizenship        String?
  personalEmail      String?
  maritalStatus      MaritalStatus
  childrenCount      Int?
  religion           Religion
  nik                String
  phone              String
  simA               String?
  simB               String?
  simC               String?

  // B. Data Keluarga (JSON: FamilyMember[])
  familyImmediate    Json?
  familyExtended     Json?

  // C. Pendidikan Formal (JSON: FormalEducationRow[])
  formalEducation    Json?

  // D. Pendidikan Non-Formal (JSON: NonFormalEducationRow[])
  nonFormalEducation Json?

  // E. Penguasaan Bahasa Asing (JSON: LanguageRow[])
  languages          Json?

  // F. Pengalaman Kerja (JSON: WorkExperienceRow[])
  workExperience     Json?
  lastJobDescription String?       @db.Text
  lastSalaryTotal    String?
  expectedSalary     String?
  hasBpjsTk          Boolean       @default(false)
  bpjsTkNumber       String?
  hasBpjsKes         Boolean       @default(false)
  bpjsKesNumber      String?

  // G. Lain-lain — questions 1,2,5,6,7,8 carry a Yes/No flag plus an
  // explanation (required only when the flag is Yes).
  qLegalIssueYes        Boolean    @default(false)
  qLegalIssue           String?    @db.Text
  qTerminatedYes        Boolean    @default(false)
  qTerminated           String?    @db.Text
  qSmoking              Boolean    @default(false)
  qTattoo               Boolean    @default(false)
  qSeriousIllnessYes    Boolean    @default(false)
  qSeriousIllness       String?    @db.Text
  qAllergyYes           Boolean    @default(false)
  qAllergy              String?    @db.Text
  qSkinLungDiseaseYes   Boolean    @default(false)
  qSkinLungDisease      String?    @db.Text
  qHereditaryDiseaseYes Boolean    @default(false)
  qHereditaryDisease    String?    @db.Text
  qPrevSupervisor       String?    @db.Text
  qStartDate            String?
  qOrganization         String?    @db.Text
  qEmergencyContact     String?    @db.Text
  qRelativeInCompany    String?    @db.Text
  qWorkedAtBst          String?    @db.Text

  submittedAt        DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([submittedAt])
}
